{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Label Renovate PRs for yayornay without automatically assigning or requesting human review.",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":automergeAll"
  ],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "addLabels": ["ai-triage"],
  "assignees": [],
  "reviewers": [],
  "packageRules": [
    {
      "description": "Work around npm/cli#9800 when regenerating lockfiles with bundled dependencies",
      "matchManagers": [
        "npm"
      ],
      "skipInstalls": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
